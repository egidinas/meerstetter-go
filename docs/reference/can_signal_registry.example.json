{
  "schema_version": 1,
  "name": "example-bench",
  "description": "Illustrative CAN signal registry: RMM-1182 producers hand their channel-1 value-conversion result to TEC consumers as external object temperature, using each producer's default TPDO1 COB-ID (0x180 + node_id). Node IDs and roles here are synthetic placeholders — replace them with your bench's, or strip every node_id to use this as a reusable pattern. A live diff reports drift until the producers' TPDO mappings and the consumers' RPDO mappings and source-selects are configured to match.",
  "nodes": [
    {"role": "rmm-1", "node_id": 16, "family": "rmm-1182"},
    {"role": "rmm-2", "node_id": 17, "family": "rmm-1182"},
    {"role": "rmm-3", "node_id": 18, "family": "rmm-1182"},
    {"role": "tec-1", "node_id": 32, "family": "tec-1166"},
    {"role": "tec-2", "node_id": 33, "family": "tec-1166"},
    {"role": "tec-3", "node_id": 34, "family": "tec-1166"},
    {"role": "tec-4", "node_id": 35, "family": "tec-1166"}
  ],
  "signals": [
    {
      "cob_id": "0x190",
      "name": "rmm1_ch1_to_tec1_tec2",
      "description": "RMM-1 channel-1 result (default TPDO1, COB-ID 0x180+node) feeds the external object temperature of TEC-1 and TEC-2.",
      "rate_ms": 100,
      "producer": {
        "role": "rmm-1",
        "tpdo": 1,
        "mapping": [{"index": "0x4000", "subindex": 1, "bits": 32, "comment": "value conversion result, channel 1"}]
      },
      "consumers": [
        {
          "role": "tec-1",
          "rpdo": 1,
          "mapping": [{"index": "0x4200", "subindex": 1, "bits": 32, "comment": "external object temperature, instance 1"}],
          "source_selects": [{"index": "0x3300", "subindex": 1, "value": 7, "comment": "object temp source = external"}]
        },
        {
          "role": "tec-2",
          "rpdo": 1,
          "mapping": [{"index": "0x4200", "subindex": 1, "bits": 32, "comment": "external object temperature, instance 1"}],
          "source_selects": [{"index": "0x3300", "subindex": 1, "value": 7, "comment": "object temp source = external"}]
        }
      ]
    },
    {
      "cob_id": "0x191",
      "name": "rmm2_ch1_to_tec3",
      "description": "RMM-2 channel-1 result (default TPDO1, COB-ID 0x180+node) feeds TEC-3 external object temperature.",
      "rate_ms": 100,
      "producer": {
        "role": "rmm-2",
        "tpdo": 1,
        "mapping": [{"index": "0x4000", "subindex": 1, "bits": 32, "comment": "value conversion result, channel 1"}]
      },
      "consumers": [
        {
          "role": "tec-3",
          "rpdo": 1,
          "mapping": [{"index": "0x4200", "subindex": 1, "bits": 32, "comment": "external object temperature, instance 1"}],
          "source_selects": [{"index": "0x3300", "subindex": 1, "value": 7, "comment": "object temp source = external"}]
        }
      ]
    },
    {
      "cob_id": "0x192",
      "name": "rmm3_ch1_to_tec4",
      "description": "RMM-3 channel-1 result (default TPDO1, COB-ID 0x180+node) feeds TEC-4 external object temperature.",
      "rate_ms": 100,
      "producer": {
        "role": "rmm-3",
        "tpdo": 1,
        "mapping": [{"index": "0x4000", "subindex": 1, "bits": 32, "comment": "value conversion result, channel 1"}]
      },
      "consumers": [
        {
          "role": "tec-4",
          "rpdo": 1,
          "mapping": [{"index": "0x4200", "subindex": 1, "bits": 32, "comment": "external object temperature, instance 1"}],
          "source_selects": [{"index": "0x3300", "subindex": 1, "value": 7, "comment": "object temp source = external"}]
        }
      ]
    }
  ]
}
