  "protocol_inventory": [
    {
      "command": "RS",
      "status": "native_control",
      "bridge_behavior": "Forwarded to ControlClient.Reset when available; otherwise NACKs as unsupported.",
      "source_evidence": ["MeCom Protocol Specification 5117F#2.1", "mecomserver/device_bridge.go#deviceBridgePayload"]
    },
    {
      "command": "?IF",
      "status": "synthesized_identity",
      "bridge_behavior": "Returns the CoSo-compatible TEC firmware identification string for CAN-backed routes.",
      "source_evidence": ["MeCom Protocol Specification 5117F#2.2", "CoSo connection log: Device 8065-TEC SW G01"]
    },
    {
      "command": "?VR",
      "status": "canopen_mapped_numeric_read",
      "bridge_behavior": "Reads one numeric MeCom parameter through the canonical MeCom-ID to CANopen SDO map; documented compatibility exceptions are listed in bridge_transforms.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.1", "catalogues/sources/tec_canopen_sdo_map.v631.json#mappings"]
    },
    {
      "command": "VS",
      "status": "canopen_mapped_numeric_or_latin1_write",
      "bridge_behavior": "Writes mapped numeric parameters through WriteClient and LATIN1 values through StringWriteClient when available.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.2", "catalogues/tec.json#write_parameters"]
    },
    {
      "command": "?VM",
      "status": "synthesized_metadata",
      "bridge_behavior": "Returns metadata with MeParType, flags, instance count, element count, bounds, and a zero actual value from the runtime parameter catalogue.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.3", "mecomserver/device_bridge.go#deviceBridgeMetadata"]
    },
    {
      "command": "?VB",
      "status": "synthesized_big_data_read",
      "bridge_behavior": "Returns an empty but well-formed LATIN1 big-data response for User Notes ID 120 on CAN-backed CoSo routes.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.4", "catalogues/tec.json#write_parameters.120"]
    },
    {
      "command": "VB",
      "status": "string_big_data_write",
      "bridge_behavior": "Accepts single-package LATIN1 big-data writes through StringWriteClient when available.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.5", "mecom/protocol.go#BuildSetBigDataStringFrame"]
    },
    {
      "command": "?VX",
      "status": "canopen_mapped_bulk_read",
      "bridge_behavior": "Reads multiple numeric MeCom parameters through the canonical runtime map, preserving requested parameter order.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.6", "mecomserver/device_bridge.go#deviceBridgeBulkRead"]
    },
    {
      "command": "?VL",
      "status": "synthesized_legacy_limits",
      "bridge_behavior": "Returns legacy type and bounds metadata for compatibility with older MeCom clients.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.7", "mecomserver/device_bridge.go#deviceBridgeLimits"]
    },
    {
      "command": "SP",
      "status": "native_control",
      "bridge_behavior": "Forwarded to ControlClient.SaveToFlash when available; otherwise NACKs as unsupported.",
      "source_evidence": ["MeCom Protocol Specification 5117F#3.2.8", "mecomserver/device_bridge.go#deviceBridgePayload"]
    },
    {
      "command": "?RS0000",
      "status": "empty_ring_pointer_when_unsupported",
      "bridge_behavior": "Forwards to ring-capable clients; CANopen routes that report unsupported return pointer zero so CoSo ring stream setup does not abort.",
      "source_evidence": ["mecom/protocol.go#BuildRingPointerFrame", "mecom/canopen_client.go#ReadRingPointer"]
    },
    {
