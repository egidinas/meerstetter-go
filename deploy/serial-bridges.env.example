# Example config for deploy/start-meerstetter-serial-bridges.sh.
# Copy to ~/.config/meerstetter/serial-bridges.env or point
# MEERSTETTER_SERIAL_BRIDGES_CONFIG at a site-local copy.

BIND_ADDR=0.0.0.0
VSERVER=mecomvseriald
SOCAT=socat
MODE=vserial
BAUD=57600
LISTEN_PORT=50000
CAN_LISTEN_PORT=50010

MECOM_ADDRESS_ZERO=disabled
CAN_MECOM_ADDRESS_ZERO=auto-first
MECOM_ROUTE_POLICY=dynamic

ENABLE_SERIAL_ROUTES=auto
ENABLE_CAN_ROUTES=auto
ENABLE_CAN_TCP=auto
CAN_IFACE=can0

ENABLE_REMOTE_CAN_ROUTES=off
REMOTE_CAN_HOST=
REMOTE_CAN_PORT=50010
REMOTE_CAN_PROBE=tcp

CAN_TRACE_FRAMES=0

# Prefer key/value rows for mixed fleets. serial, can, remote/endpoint/target,
# and legacy are optional; use "-" or "off" to omit a field. When a remote
# endpoint is omitted, a row inherits REMOTE_CAN_HOST/REMOTE_CAN_PORT if enabled
# and healthy.
MECOM_ROUTE_COUNT=5
MECOM_ROUTE_1=addr=75,serial=CONTROLLER_A,can=0x4b,legacy=50002
MECOM_ROUTE_2=addr=76,serial=CONTROLLER_B,can=0x4c,legacy=50003
MECOM_ROUTE_3=addr=81,serial=-,can=0x51,legacy=-
MECOM_ROUTE_4=addr=84,serial=/dev/serial/by-id/usb-FTDI_FT230X_Basic_UART_CONTROLLER_D-if00-port0,can=-,remote=off,legacy=50005
MECOM_ROUTE_5=addr=90,serial=-,can=-,endpoint=tcp:192.168.1.10:50010,legacy=-

# endpoint/target/bridge may be a PiXtend CAN bridge, Kvaser DIN-rail TCP
# bridge, or another transparent MeCom TCP router.

# The compact legacy-compatible form is still accepted:
# MECOM_ROUTE_1=75:CONTROLLER_A:0x4b:50002
