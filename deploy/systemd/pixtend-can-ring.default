# PiXtend V2-L Meerstetter CAN capture defaults.
# Keep this service local and deterministic; export/publish from a separate
# process so CAN capture survives master/network outages.
# The primary ring is RAM-backed. Flash is a live mirrored fallback/bootstrap
# ring, not a second owner-facing stream.
CAN_IF=can0
CAN_OVERLAY=mcp2515-can1
BITRATE=1000000
OSC=20000000
INTPIN=4
SPIMAX=1000000
PIXTEND_CAN_ENABLE_GPIOS="24 27"
RING_PATH=/run/meerstettergo-ring/pixtend-can0.ring
RING_SIZE=64MiB
RING_CHUNK=64KiB
FALLBACK_RING_PATH=/var/lib/meerstettergo/pixtend-can0.ring
FALLBACK_RING_SIZE=8GiB
FALLBACK_RING_CHUNK=4MiB
FALLBACK_RING_SYNC=1
BOOTSTRAP_RING_PATH=/var/lib/meerstettergo/pixtend-can0.bootstrap.ring
BOOTSTRAP_ON_START=0
CHECKPOINT_ON_EXIT=0
LISTEN_WINDOW=24h
